class Solution:
    def setZeroes(self, matrix: List[List[int]]) -> None:
        ch=1
        m=len(matrix)
        n=len(matrix[0])
        for i in range(m):
            for j in range(n):
                if matrix[i][j]==0:
                    if j==0:
                        ch=0
                    else:
                        matrix[0][j]=0
                    matrix[i][0]=0
        for j in range(1,n):
            if matrix[0][j]==0:
                for i in range(m):
                    matrix[i][j]=0
        for i in range(m):
            if matrix[i][0]==0:
                for j in range(n):
                    matrix[i][j]=0
        if ch==0:
            for i in range(m):
                matrix[i][0]=0
        
        
        
        
